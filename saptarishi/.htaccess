# GoDaddy / Apache — saptarishi.ranjanravi.com document root
# Upload the whole saptarishi/ folder (this file + ui/ + index.html) to the subdomain root.

DirectoryIndex index.html ui/html/kundali.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Site root → kundali app
  RewriteRule ^$ ui/html/kundali.html [L]

  # Optional short paths (if you link without /ui/html/)
  RewriteRule ^kundali/?$ ui/html/kundali.html [L]
  RewriteRule ^auspicious/?$ ui/html/auspicious.html [L]
</IfModule>
